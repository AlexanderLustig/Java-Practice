import java.util.Scanner;
import java.util.Random;

public class Main30 {

    static Scanner scanner = new Scanner(System.in);
    static Random random = new Random();
    static int rolesSum = 0;
    static String decision = "";
    static int diceRole = 0;
    public static void main(String[] args) {

        mainLoop();

    
        scanner.close();
    }

    static void mainLoop() {
    System.out.print("Would you like to roll the die? Yes or No: ");
    decision = scanner.nextLine();

    while (decision.equalsIgnoreCase("Yes")) {
        diceRole = random.nextInt(6) + 1;
        rolesSum += diceRole;

        if (diceRole == 1) {
            one();
        } else if (diceRole == 2) {
            two();
        } else if (diceRole == 3) {
            three();
        } else if (diceRole == 4) {
            four();
        } else if (diceRole == 5) {
            five();
        } else if (diceRole == 6) {
            six();
        }

        System.out.println("Your added Roll Sum is " + rolesSum);
        System.out.print("Would you like to roll again? Yes or No: ");
        decision = scanner.nextLine();  // ask again before looping
    }

    // when they stop saying "Yes"
    System.out.println("Game over. Your final Roll Sum is " + rolesSum);
}

