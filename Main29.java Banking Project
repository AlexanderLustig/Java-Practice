import java.util.Scanner;

public class Main29 {
    static Scanner scanner = new Scanner(System.in);
    static double balance = 0.0;

    public static void main(String[] args) {

        int choice = mainLoop();

        while (choice != 4) {
            if (choice == 1) {
                balance();
            } else if (choice == 2) {
                deposit();
            } else if (choice == 3) {
                withdraw();
            } else {
                System.out.println("Invalid choice.");
            }

            System.out.println("Anything else you wish to do today?");
            choice = mainLoop();
        }

        System.out.println("Have a good day");
        scanner.close();
    }

    static int mainLoop() {
        System.out.println("1. Show Balance");
        System.out.println("2. Deposit");
        System.out.println("3. Withdraw");
        System.out.println("4. Exit");
        System.out.print("Enter your choice (1-4): ");
        int choice = scanner.nextInt();
        return choice;
    }

    static void balance() {
        System.out.println("Your current balance is : $" + balance);
    }

    static void deposit() {
        System.out.print("How much are you depositing? : ");
        double depositAmount = scanner.nextDouble();

        balance = balance + depositAmount;

        System.out.println("You just deposited: $" + depositAmount);
        System.out.println("Your current balance is now: $" + balance);
    }

    static void withdraw() {
        System.out.print("How much are you withdrawing? : ");
        double withdrawAmount = scanner.nextDouble();

        if (withdrawAmount > balance) {
            System.out.println("Insufficient funds.");
        } else {
            balance = balance - withdrawAmount;
            System.out.println("You just withdrew: $" + withdrawAmount);
            System.out.println("Your current balance is now: $" + balance);
        }
    }
}

